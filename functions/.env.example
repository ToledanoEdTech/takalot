# Email notification secrets for Cloud Functions
# Set via: firebase functions:secrets:set SECRET_NAME
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=takalot@zvialod.com
# SMTP_PASS=your-app-password
#
# Recipients are managed in the website admin panel (settings/notifications in Firestore).
#
# Optional params:
# EMAIL_FROM=takalot@zvialod.com
# APP_URL=https://takalot-beige.vercel.app
