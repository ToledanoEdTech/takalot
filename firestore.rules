rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Definition
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isAdmin() {
      return isSignedIn()
        && 'email' in request.auth.token
        && (
          request.auth.token.email == 'yosseftole@zvialod.com'
          || request.auth.token.email == 'yossitole@gmail.com'
        );
    }

    function faultExists(faultId) {
      return exists(/databases/$(database)/documents/faults/$(faultId));
    }

    function faultCreatedBy(faultId) {
      return get(/databases/$(database)/documents/faults/$(faultId)).data.createdBy;
    }

    // Validation Blueprint for Fault
    function isValidFaultFields(data) {
      return data.keys().hasAll(['title', 'description', 'location', 'reporterName', 'status', 'createdAt', 'updatedAt', 'createdBy'])
        && (!('hasImage' in data) || data.hasImage is bool)
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000000))
        && (!('treatmentNote' in data) || (data.treatmentNote is string && data.treatmentNote.size() <= 1000))
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.description is string && data.description.size() >= 0 && data.description.size() <= 1000
        && data.location is string && data.location.size() > 0 && data.location.size() <= 100
        && data.reporterName is string && data.reporterName.size() > 0 && data.reporterName.size() <= 100
        && data.status is string && (data.status == 'open' || data.status == 'in_progress' || data.status == 'fixed')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string;
    }

    // New schema: hasImage flag, image stored in fault_images
    function isCreateFaultNewSchema(data) {
      let hasTreatmentNote = 'treatmentNote' in data ? 1 : 0;
      return isValidFaultFields(data)
        && data.keys().hasAll(['hasImage'])
        && data.hasImage is bool
        && !('imageUrl' in data)
        && data.createdBy == request.auth.uid
        && data.keys().size() == 9 + hasTreatmentNote
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.status == 'open';
    }

    // Legacy schema still deployed on some environments
    function isCreateFaultLegacySchema(data) {
      let hasImageUrl = 'imageUrl' in data ? 1 : 0;
      let hasTreatmentNote = 'treatmentNote' in data ? 1 : 0;
      return isValidFaultFields(data)
        && !('hasImage' in data)
        && data.createdBy == request.auth.uid
        && data.keys().size() == 8 + hasImageUrl + hasTreatmentNote
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.status == 'open';
    }

    function isCreateFaultValid(data) {
      return isCreateFaultNewSchema(data) || isCreateFaultLegacySchema(data);
    }

    function isValidStatus(status) {
      return status is string && (status == 'open' || status == 'in_progress' || status == 'fixed');
    }

    function isUpdateFaultValid(data, oldData) {
      return data.createdAt == oldData.createdAt
        && data.createdBy == oldData.createdBy
        && data.updatedAt == request.time;
    }

    function isStatusOnlyUpdate() {
      return incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    function isTreatmentUpdate() {
      return incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'treatmentNote'])
        && incoming().status == 'in_progress'
        && (!('treatmentNote' in incoming()) || (incoming().treatmentNote is string && incoming().treatmentNote.size() <= 1000));
    }

    function isDetailsUpdate() {
      return incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'location', 'status', 'updatedAt', 'treatmentNote', 'imageUrl', 'hasImage']);
    }

    // 1. Faults Collection
    match /faults/{faultId} {
      allow get: if isSignedIn() && isValidId(faultId);
      allow list: if isSignedIn();

      allow create: if isSignedIn()
        && isValidId(faultId)
        && isCreateFaultValid(incoming());

      allow update: if isSignedIn()
        && isValidId(faultId)
        && isUpdateFaultValid(incoming(), existing())
        && (
          (isStatusOnlyUpdate() && isValidStatus(incoming().status)) ||
          (isTreatmentUpdate() && isValidStatus(incoming().status)) ||
          (isDetailsUpdate() && isValidFaultFields(incoming()))
        );

      allow delete: if isSignedIn() && isValidId(faultId);
    }

    // 2. Fault Images (lazy-loaded, separate from fault metadata)
    match /fault_images/{faultId} {
      allow get: if isSignedIn() && isValidId(faultId);
      allow list: if false;

      allow create: if isSignedIn()
        && isValidId(faultId)
        && faultExists(faultId)
        && faultCreatedBy(faultId) == request.auth.uid
        && incoming().keys().hasOnly(['data'])
        && incoming().data is string
        && incoming().data.size() <= 150000;

      allow delete: if isSignedIn()
        && isValidId(faultId)
        && (isAdmin() || !faultExists(faultId) || faultCreatedBy(faultId) == request.auth.uid);

      allow update: if false;
    }
  }
}
