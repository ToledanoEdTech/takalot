rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Definition
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; } // In a real app we'd check request.auth.token.email_verified == true, but we'll stick to basic auth here for demo unless required. Let's use it without email_verified to avoid friction for simple Google Sign In if they don't have verified emails. Actually, standard is request.auth != null.

    function isAdmin() { 
      return isSignedIn() && 'email' in request.auth.token && request.auth.token.email == 'yosseftole@zvialod.com'; 
    }

    // Validation Blueprint for Fault
    function isValidFaultFields(data) {
      return data.keys().hasAll(['title', 'description', 'location', 'reporterName', 'status', 'createdAt', 'updatedAt', 'createdBy'])
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000000))
        && (!('treatmentNote' in data) || (data.treatmentNote is string && data.treatmentNote.size() <= 1000))
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.description is string && data.description.size() >= 0 && data.description.size() <= 1000
        && data.location is string && data.location.size() > 0 && data.location.size() <= 100
        && data.reporterName is string && data.reporterName.size() > 0 && data.reporterName.size() <= 100
        && data.status is string && (data.status == 'open' || data.status == 'in_progress' || data.status == 'fixed')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string;
    }

    function isCreateFaultValid(data) {
      let hasImageUrl = 'imageUrl' in data ? 1 : 0;
      let hasTreatmentNote = 'treatmentNote' in data ? 1 : 0;
      
      return isValidFaultFields(data)
        && data.createdBy == request.auth.uid
        && data.keys().size() == 8 + hasImageUrl + hasTreatmentNote
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidStatus(status) {
      return status is string && (status == 'open' || status == 'in_progress' || status == 'fixed');
    }

    function isUpdateFaultValid(data, oldData) {
      return data.createdAt == oldData.createdAt
        && data.createdBy == oldData.createdBy
        && data.updatedAt == request.time;
    }

    function isStatusOnlyUpdate() {
      return incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    function isTreatmentUpdate() {
      return incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'treatmentNote'])
        && incoming().status == 'in_progress'
        && (!('treatmentNote' in incoming()) || (incoming().treatmentNote is string && incoming().treatmentNote.size() <= 1000));
    }

    function isDetailsUpdate() {
      return incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'location', 'status', 'updatedAt', 'imageUrl', 'treatmentNote']);
    }

    // 1. Faults Collection
    match /faults/{faultId} {
      // Get: Any signed-in user can read all faults
      allow get: if isSignedIn() && isValidId(faultId);
      
      // List: Any signed in user can list them
      allow list: if isSignedIn();

      // Create: Must be signed in, valid ID, valid schema, no extra fields
      allow create: if isSignedIn() 
        && isValidId(faultId) 
        && isCreateFaultValid(incoming());

      // Update: Any signed in user can update status or details
      allow update: if isSignedIn() 
        && isValidId(faultId) 
        && isUpdateFaultValid(incoming(), existing())
        && (
          (isStatusOnlyUpdate() && isValidStatus(incoming().status)) ||
          (isTreatmentUpdate() && isValidStatus(incoming().status)) ||
          (isDetailsUpdate() && isValidFaultFields(incoming()))
        );

      // Delete: Let creator delete their own mistakes, or admins can delete anything
      allow delete: if isSignedIn() && (request.auth.token.email == 'yosseftole@zvialod.com' || resource.data.createdBy == request.auth.uid);
    }
  }
}
