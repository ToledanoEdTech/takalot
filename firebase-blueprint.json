{
  "entities": {
    "fault": {
      "title": "Fault",
      "description": "A fault reported by a teacher",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Short description of the fault",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the fault",
          "maxLength": 1000
        },
        "location": {
          "type": "string",
          "description": "Location of the fault (e.g., Room 101)",
          "maxLength": 100
        },
        "reporterName": {
          "type": "string",
          "description": "Name of the person who reported the fault",
          "maxLength": 100
        },
        "status": {
          "type": "string",
          "enum": ["open", "in_progress", "fixed"],
          "description": "Current status of the fault"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the fault was reported"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the fault was last updated"
        },
        "createdBy": {
          "type": "string",
          "description": "User ID of the reporter"
        },
        "imageUrl": {
          "type": "string",
          "description": "Base64 encoded image of the fault, max 900KB"
        },
        "treatmentNote": {
          "type": "string",
          "description": "Notes about continued treatment",
          "maxLength": 1000
        }
      },
      "required": ["title", "description", "location", "reporterName", "status", "createdAt", "updatedAt", "createdBy"]
    }
  },
  "firestore": {
    "faults/{faultId}": {
      "schema": {
        "$ref": "#/entities/fault"
      },
      "description": "Collection of all reported faults"
    }
  }
}
